<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Employee Login</title>
</head>
<body>
    <h1>Employee Login</h1>

    <form action="/login/validateuser" method="POST">
        <input type="email" name="email" placeholder="Email" required /><br><br>
        <input type="password" name="password" placeholder="Password" required /><br><br>
        <button type="submit" name="btn" id="login" value="login">Login</button>

        <button type="reset" name="reset" id="reset" value="reset">reset</button>
        
    </form>
    <p>Don't have an account? <a href="/login/register">Register</a></p>
    <p>Forgot password? <a href="/login/forgotpassword">click here!</a></p>
</body>
</html>