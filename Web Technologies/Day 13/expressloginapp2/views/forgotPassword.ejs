<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password</title>
</head>
<body>
    <h2>Forgot Password</h2>
    <form action="updatepassword" method="post">
        <h2>Email : <input type="email" name="email" id="email"></h2><br></h2>
        <h2>New Password : <input type="password" name="pass" id="pass"></h2>

        <button type="submit" id="forgotPassword" value="forgotPassword" name="forgotPassword">Login with new password...</button>
    </form>
</body>
</html>