@model ProductManagement.Models.Product

<html>
<head>
    <title>Create Product</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.css" rel="stylesheet" />
    <script src="~/lib/bootstrap/dist/js/bootstrap.js"></script>
</head>
<body class="container">
    <hr />
    <a href="/Home/Index" class="btn btn-primary">Home</a>
    <hr />

    <div class="table-responsive">
        <form action="/Home/AfterEdit" method="post">
            <input type="hidden" name="pid" value="@Model.pid" />
            <table class="table table-bordered text-center">

                <tbody>
                    <tr>
                        <td>Enter Product Name</td>
                        <td>
                            <input type="text" name="pname" value="@Model.pname"/>
                        </td>
                    </tr>

                    <tr>
                        <td>Enter Quantity</td>
                        <td>
                            <input type="text" name="qty" value="@Model.qty"/>
                        </td>
                    </tr>

                    <tr>
                        <td>Enter Price</td>
                        <td>
                            <input type="text" name="price" value="@Model.price" />
                        </td>
                    </tr>

                    <tr>
                        <td colspan="2">
                            <input type="submit" value="Update" name="btnEdit" class="btn btn-primary" />
                        </td>
                    </tr>
                </tbody>
            </table>
        </form>
    </div>
</body>
</html>