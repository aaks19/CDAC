@model CarShowroom.Models.Car

<html>
<head>
    <title>Home</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.css" rel="stylesheet" />
    <script src="~/lib/bootstrap/dist/js/bootstrap.js"></script>
</head>
<body class=" container">
    <hr />
    <a href="/Home/Index" class=" btn btn-primary">Back to Home</a>
    <hr />
    <br />
    <div class="table-responsive">
        <form method="post" action="/Home/AfterEdit">
            <table class="table table-bordered">

                <tbody>
                    <input type="hidden" name="id" value="@Model.id"/>
                    <tr>
                        <td>Car Name</td>
                        <td>
                            <input type="text" name="name" value="@Model.name" />
                        </td>
                    </tr>
                    <tr>
                        <td>Car Color</td>
                        <td>
                            <input type="text" name="color" value="@Model.color" />
                        </td>
                    </tr>
                    <tr>
                        <td>quantity</td>
                        <td>
                            <input type="number" name="qty" value="@Model.qty" />
                        </td>

                    </tr>
                    <tr>
                        <td>price</td>
                        <td>
                            <input type="number" name="price" value="@Model.price" />
                        </td>
                    </tr>

                    <tr>

                        <td colspan="3">
                            <input type="submit" name="btnUpdate" value="Update" />
                        </td>
                    </tr>

                </tbody>
            </table>
        </form>
    </div>
</body>
</html>