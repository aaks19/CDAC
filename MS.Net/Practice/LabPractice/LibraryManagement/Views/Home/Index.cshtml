@model List<LibraryManagement.Models.Book>

<html>
    <head>
        <title>Home</title>
        <link href="~/lib/bootstrap/dist/css/bootstrap.css" rel="stylesheet" />
        <script src="~/lib/bootstrap/dist/js/bootstrap.js"></script>
    </head>
    <body class="container">
        <hr />
        <a href="/Home/Create" class="btn btn-primary">Add New Book</a>
        <hr />
        <br />
        <div class="table-responsive">
        <table class="table table-bordered text-center">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Book Name</th>
                    <th>Author</th>
                    <th>Quantity</th>
                    <th>Price</th>
                    <th>Edit</th>
                    <th>Delete</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var book in Model)
                {
                    <tr>
                        <td>@book.id</td>
                        <td>@book.bname</td>
                        <td>@book.author</td>
                        <td>@book.qty</td>
                        <td>@book.price</td>

                        <td>
                            <a href="/Home/Edit/@book.id" class="btn btn-warning">Edit</a>
                        </td>

                        <td>
                            <a href="/Home/DeleteBook/@book.id" class="btn btn-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    </body>
</html>
