<html>
    <head>
        <title>Create</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.css" rel="stylesheet" />
    <script src="~/lib/bootstrap/dist/js/bootstrap.js"></script>
</head>
<body class="container">
    <hr />
    <a href="/Home/Index" class="btn btn-primary">Back to Home</a>
    <hr />
    <br />
    <div class="table-responsive">
        <form action="/Home/AfterCreate" method="post">
            <table class="table table-bordered text-center">
                <tbody>
                    <tr>
                        <td>Book Name</td>
                        <td>
                            <input type="text" name="bname" />
                        </td>
                        <td style="color: red">
                            @Html.ValidationMessage("bname")
                        </td>
                    </tr>

                    <tr>
                        <td>Author</td>
                        <td>
                            <input type="text" name="author" />
                        </td>
                        <td style="color: red">
                            @Html.ValidationMessage("author")
                        </td>
                    </tr>

                    <tr>
                        <td>Quantity</td>
                        <td>
                            <input type="number" name="qty" />
                        </td>
                        <td style="color: red">
                            @Html.ValidationMessage("qty")
                        </td>
                    </tr>

                    <tr>
                        <td>Price</td>
                        <td>
                            <input type="number" name="price" />
                        </td>
                        <td style="color: red">
                            @Html.ValidationMessage("price")
                        </td>
                    </tr>

                    <tr>
                        <td colspan="2">
                            <input type="submit" name="btnAdd" class="btn btn-primary" value="Submit" />
                        </td>
                    </tr>

                </tbody>
            </table>
        </form>
    </div>
</body>
</html>
